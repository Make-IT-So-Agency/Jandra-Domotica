# Kopieer deze waarden naar de omgevingsvariabelen van je Vercel-project.
# Zet ze allemaal voor Production, Preview én Development.

# --- Supabase -------------------------------------------------------------
# Te vinden in Supabase onder Project Settings > API.
SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
# De service_role sleutel. Deze blijft server-side en mag NOOIT in de browser
# terechtkomen; gebruik hem dus niet met een NEXT_PUBLIC_ voorvoegsel.
SUPABASE_SERVICE_ROLE_KEY="..."

# --- Inloggen met Google --------------------------------------------------
# Aanmaken via https://console.cloud.google.com > API's en services > Inloggegevens
AUTH_GOOGLE_ID="....apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="..."
# Willekeurige geheime tekst; genereer met: openssl rand -base64 32
AUTH_SECRET="..."
# Het adres van de app, zonder schuine streep op het einde.
AUTH_URL="https://laadkosten.jouwdomein.be"

# Wie mag binnen? Komma's ertussen. Enkel deze adressen geraken in de app.
TOEGELATEN_EMAILS="jan@makeitso.be"

# --- Koppeling met Home Assistant ----------------------------------------
# Dezelfde sleutel vul je in bij de HACS-integratie. Genereer met:
#   openssl rand -hex 32
INGEST_API_KEY="..."

# --- Automatische taken ---------------------------------------------------
# Beveiligt de cron-endpoints van Vercel. Genereer met: openssl rand -hex 32
CRON_SECRET="..."
